{
  "name": "AI Research Team Workflow",
  "nodes": [
    {
      "parameters": {
        "path": "start-research",
        "responseMode": "lastNode",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [0, 0],
      "typeVersion": 1
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8000/api/research",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{ $json.query.query }}"
            },
            {
              "name": "max_retries",
              "value": 3
            }
          ]
        },
        "options": {}
      },
      "name": "Start Job",
      "type": "n8n-nodes-base.httpRequest",
      "position": [220, 0],
      "typeVersion": 4
    },
    {
      "parameters": {
        "amount": 5
      },
      "name": "Wait 5s",
      "type": "n8n-nodes-base.wait",
      "position": [440, 0],
      "typeVersion": 1
    },
    {
      "parameters": {
        "url": "=http://127.0.0.1:8000/api/jobs/{{ $('Start Job').item.json.job_id }}",
        "options": {}
      },
      "name": "Check Status",
      "type": "n8n-nodes-base.httpRequest",
      "position": [660, 0],
      "typeVersion": 4
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.status }}",
              "operation": "in",
              "value2": "COMPLETED,FAILED"
            }
          ]
        }
      },
      "name": "Is Finished?",
      "type": "n8n-nodes-base.if",
      "position": [880, 0],
      "typeVersion": 1
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Start Job",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start Job": {
      "main": [
        [
          {
            "node": "Wait 5s",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Wait 5s": {
      "main": [
        [
          {
            "node": "Check Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Status": {
      "main": [
        [
          {
            "node": "Is Finished?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is Finished?": {
      "main": [
        [],
        [
          {
            "node": "Wait 5s",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}